# Copy this file to .env.local and fill in the values.
#
# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API Keys
# ---------------------------------------------------------------------------
# Only the PUBLISHABLE key belongs here. It is safe in a browser because
# row-level security is what actually protects the data.
# NEVER put the secret key in this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Google Maps — https://console.cloud.google.com/google/maps-apis/credentials
# ---------------------------------------------------------------------------
# Enable the "Maps JavaScript API" for the project, then create an API key.
#
# This key is visible to anyone who opens the console, which is unavoidable for
# a browser map. Protect it in the Google Cloud console instead:
#   1. Application restrictions -> HTTP referrers, listing only your domains
#      (include http://localhost:5173/* for development)
#   2. API restrictions -> Maps JavaScript API only
# Without those two restrictions the key can be lifted and billed to you.
#
# The live map falls back to a schematic view when this is empty, so the rest
# of the console works without it.

VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Google Cloud, needed for cloud-based map styling.
VITE_GOOGLE_MAPS_MAP_ID=

# ---------------------------------------------------------------------------
# Backend switch
# ---------------------------------------------------------------------------
# true  - every screen reads from src/mocks (the default when unset)
# false - screens read from Supabase
#
# Screen data only. Signing in is always real, whatever this is set to - there
# is no mock login, so the only way into the console is a Supabase account.
#
# Vite reads env at build time, so restart the dev server after changing it.

VITE_USE_MOCK_DATA=false
