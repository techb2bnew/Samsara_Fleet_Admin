# Secrets for database work only. Used by the Supabase CLI on your machine.
# These NEVER go into either app's .env file.
#
# SUPABASE_SECRET_KEY bypasses every row-level-security policy. Anyone
# holding it can read and delete every tenant's data.

SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
SUPABASE_SECRET_KEY=
